# =================================================================
# OpsMind Production Environment Variables Specification
# =================================================================

# -----------------------------------------------------------------
# 1. Express Backend Service (Node.js)
# -----------------------------------------------------------------
NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection String
# Get your URI from cloud.mongodb.com -> Connect -> Drivers -> Node.js
# Example: mongodb+srv://opsmind_admin:P%40ssw0rdSecure@opsmind-cluster.abcde.mongodb.net/opsmind?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/opsmind?retryWrites=true&w=majority

# JWT Token Secret (Generate using: openssl rand -base64 32)
JWT_SECRET=generate_a_random_32_byte_secret_key_for_production
JWT_EXPIRES_IN=7d

# Permitted Frontend Domains for CORS (comma-separated if multiple)
CLIENT_URL=https://opsmind.vercel.app,https://opsmind-frontend.onrender.com,http://localhost:5173

# Internal or Public URL of the FastAPI ML Service
ML_SERVICE_URL=https://opsmind-ml-service.onrender.com

# Optional OpenAI API Key for AI Copilot (falls back to deterministic reasoner if unset)
OPENAI_API_KEY=sk-proj-your-production-openai-api-key

# -----------------------------------------------------------------
# 2. FastAPI Machine Learning Service (Python)
# -----------------------------------------------------------------
PORT=8000
ENVIRONMENT=production
ALLOWED_HOSTS=*

# -----------------------------------------------------------------
# 3. React Frontend (Vite)
# -----------------------------------------------------------------
# Production API endpoint URL without trailing slash
VITE_API_BASE_URL=https://opsmind-backend.onrender.com/api
VITE_ML_SERVICE_URL=https://opsmind-ml-service.onrender.com/api/v1
