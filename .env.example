# =================================================================
# OpsMind — Master Environment Variables Example
# =================================================================

# Backend Configuration (Node.js + Express)
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/opsmind
JWT_SECRET=replace_with_a_secure_jwt_secret_in_production
JWT_EXPIRES_IN=7d

# Machine Learning & AI Copilot Service (Python + FastAPI)
ML_SERVICE_URL=http://localhost:8000
ML_PORT=8000
OPENAI_API_KEY=your_openai_api_key_for_copilot_phase_6

# Frontend Configuration (React + Vite)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_ML_SERVICE_URL=http://localhost:8000/api/v1
